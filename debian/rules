#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- --sysconfdir=/etc --localstatedir=/var --with-piddir=/run --enable-web

override_dh_installsystemd:
	dh_installsystemd
	dh_installsystemd --name=softgred-web

override_dh_compress:
	dh_compress -X.md -X.svg -X.css -X.js
