#!/bin/sh
# Enforce the project rule: never attribute commits to Claude. Strips any Claude/Anthropic
# co-authorship or "Generated with" trailer, plus resulting trailing blanks, whatever added
# it. Portable across the macOS (BSD) and container (GNU) toolchains.
set -eu
msg=$1
tmp=$(mktemp)
awk '
  /^Co-Authored-By:.*([Cc]laude|[Aa]nthropic)/ { next }
  /[Gg]enerated with \[?[Cc]laude/            { next }
  { line[++n] = $0 }
  END {
    last = 0
    for (i = 1; i <= n; i++) if (line[i] ~ /[^ \t]/) last = i
    for (i = 1; i <= last; i++) print line[i]
  }
' "$msg" >"$tmp"
mv "$tmp" "$msg"
