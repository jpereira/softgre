FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential autoconf automake clang libclang-rt-dev python3 \
    iproute2 ebtables iptables dnsmasq-base busybox iputils-ping php-cli php-sockets debhelper \
    bridge-utils net-tools htop vim strace lsof \
    systemd systemd-sysv init-system-helpers logrotate \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN ./autogen.sh && make deb \
    && scripts/install-deb.sh ../softgred_*.deb \
    && scripts/check-installed-package.sh && rm -rf /var/lib/apt/lists/*
ENV SOFTGRE_WEB_ROOT=/usr/share/softgred/webinterface
CMD ["python3", "tests/integration.py", "/usr/sbin/softgred"]
