FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang-format black shfmt php-codesniffer nodejs npm \
    build-essential autoconf automake debhelper \
    bridge-utils net-tools htop vim strace lsof \
    systemd systemd-sysv init-system-helpers logrotate \
    && npm install --global prettier@3.6.2 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN ./autogen.sh && make deb \
    && scripts/install-deb.sh ../softgred_*.deb \
    && scripts/check-installed-package.sh && rm -rf /var/lib/apt/lists/*
CMD ["scripts/format-code.sh", "--check"]
