# SoftGREd: IPv4, unkeyed GRE v0 carrying VLAN-tagged Ethernet frames.
[global]
interface = eth0
# Maximum six characters; generated VLAN interface names must fit Linux IFNAMSIZ.
tunnel-prefix = sgre
bridge-map = 10@br-gre, 11@br-gre
# Create missing bridges. Existing target interfaces must be bridges.
bridge-force = true
# Ingress authorization (recommended): only these remote IPv4 addresses or CIDR networks
# may provision tunnels. GRE is unauthenticated, so without this a spoofed source can
# create tunnels, claim client MACs or exhaust resources. Omit to accept any remote.
# allow-remotes = 203.0.113.0/24, 198.51.100.7
# Append events here; SIGHUP reopens the file after rotation.
log-file = /var/log/softgred.log
pid-file = @SOFTGRED_PIDDIR@/softgred.pid

[service]
# Read-only TCP API, no authentication. Prefer loopback.
bind-in = lo
port = 8888
# Maximum simultaneous clients (1..128), each with a five-second deadline.
max-listen = 10

[debug]
enable = false
print-time = true
